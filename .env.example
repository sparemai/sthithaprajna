# Copy to .env (never commit it). Everything here is a B0 human gate (a): the operator supplies it.
# `sthitaprajna` reads .env automatically from the folder you start it in; variables already set in the shell win.

# Dhan: primary data (read-only use). Needed for PAPER on live data: `sthitaprajna serve --mode paper`.
# Check your access first with `sthitaprajna dhan-check` (read-only; prints no secrets). Guide: docs/PAPER_LIVE_DATA.md
# DHAN_DATA_TOKEN is your Dhan access token. If Dhan gave you a single token, put it here (data calls never read
# DHAN_TRADING_TOKEN). Live quotes, history and option chains need Dhan's Data API access on your account.
DHAN_CLIENT_ID=
DHAN_DATA_TOKEN=
# Dhan: execution (write scope). Read ONLY by execution/live.py (the live broker); data code never reads it.
# Put your Dhan access token here too if Dhan gave you a single token. DHAN_EXCHANGE_ALGO_ID is the exchange-assigned
# Algo-ID Dhan gives you for LIVE orders (SEBI retail-algo framework) [VERIFY the exact field with Dhan]. Never read
# in SIM/PAPER: paper trades always carry a dummy PAPER-ALGO-0000/SIM-ALGO-0000 tag instead, on purpose.
DHAN_TRADING_TOKEN=
DHAN_EXCHANGE_ALGO_ID=

# LIVE trading is off by default even with the tokens above. `sthitaprajna serve --mode live` also needs this set
# to a truthy value (yes/true/1) -- a deliberate second switch, so credentials sitting in .env alone never turn on
# real orders. Read docs/LIVE_TRADING.md and run `sthitaprajna order-check --place-test-order` first.
STHITAPRAJNA_LIVE_TRADING_CONFIRMED=

# Upstox: secondary data only (never orders at T1-T2). Optional: without it PAPER runs single-feed (A5.5).
UPSTOX_ANALYTICS_TOKEN=

# Risk mode override for one run (bounded | unbounded). Normally set in config/operator.yaml.
# STHITAPRAJNA_RISK_MODE=bounded

# Terminal access token: REQUIRED if the server binds beyond 127.0.0.1 (e.g. a Mumbai VM)
STHITAPRAJNA_API_TOKEN=

# Discord operator channel (D10): step-by-step guide in docs/DISCORD_SETUP.md. Start with `sthitaprajna serve --discord`.
# DISCORD_OPERATOR_ID is YOUR numeric user ID (Developer Mode -> right-click your name -> Copy User ID).
DISCORD_BOT_TOKEN=
DISCORD_OPERATOR_ID=

# Email fallback when Discord is unreachable > 2 min with open positions (D10)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
